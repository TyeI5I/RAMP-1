{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run RAMPED",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_ENV": "development"
      },
      "presentation": {
        "group": "ramped",
        "order": 1
      }
    },
    {
      "name": "Debug RAMPED",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--import", "tsx"],
      "args": ["${workspaceFolder}/server.ts"],
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_ENV": "development"
      },
      "console": "integratedTerminal",
      "presentation": {
        "group": "ramped",
        "order": 2
      },
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
