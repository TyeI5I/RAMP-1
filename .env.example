# Google Gemini API key used by the backend for career tools and Tier 2 employer search
GEMINI_API_KEY=""

# Resend transactional email (verify the sender domain before production use)
RESEND_API_KEY=""
EMAIL_FROM="RAMPED <notifications@example.com>"

# Base application URL for self-referential links and hosting routing
APP_URL="http://localhost:3000"

# Shared secret for the scheduled Render lifecycle job (use a long random value)
CRON_SECRET=""

# Private-beta access lists (comma-separated, server-only)
BETA_ALLOWED_EMAILS=""
ADMIN_EMAILS=""

# Supabase project (public client values are exposed in the browser)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Supabase server values (never expose the service role key to the browser)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Port number for the Node.js server
PORT=3000

# Stripe test-mode secret key and webhook signing secret (server only)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Stripe Price IDs for the four recurring USD plans (create these in Stripe)
STRIPE_PRICE_TIER1_MONTHLY=""
STRIPE_PRICE_TIER1_ANNUAL=""
STRIPE_PRICE_TIER2_MONTHLY=""
STRIPE_PRICE_TIER2_ANNUAL=""

# Persona verification (server only; create separate ID and business inquiry templates)
PERSONA_API_KEY=""
PERSONA_WEBHOOK_SECRET=""
PERSONA_CANDIDATE_IDENTITY_TEMPLATE_ID=""
PERSONA_EMPLOYER_BUSINESS_TEMPLATE_ID=""
